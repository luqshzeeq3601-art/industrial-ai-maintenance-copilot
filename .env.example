# Environment Configuration - copy to .env and fill secrets (never commit .env)
ENV=development
DEBUG=True

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=8192

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
DEVICE=cuda
VECTOR_BACKEND=faiss

# Paths
DATABASE_PATH=backend/app/database/maintenance.db
VECTOR_STORE_DIR=vector_store
DOCS_DIR=data

# --- Secrets (required in prod, see backend/app/config.py) ---
# JWT + telemetry HMAC - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-32chars-min-in-prod
TELEMETRY_HMAC_SECRET=change-me-in-prod
# Postgres / Grafana (used by docker-compose --profile all)
POSTGRES_DB=industrial_maintenance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-prod
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-prod
# Azure OpenAI (optional, LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Azure KeyVault (optional fallback for secrets in prod)
AZURE_KEYVAULT_URL=
