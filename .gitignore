# Environments and secrets
.env
.env.local
.venv/
env/
venv/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Databases and runtime stores
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/app/database/*.db
backend/app/database/*.db-wal
backend/app/database/*.db-shm

# Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Generated runtime scratch and telemetry logs
scratch/
.system_generated/
*.log

# Vector store runtime (regenerated via python -m backend.app.rag.ingest)
vector_store/*.faiss
vector_store/**/*.faiss
vector_store/chunks_cache.json
vector_store/**/chunks_cache.json
vector_store/manifest.json
vector_store/**/manifest.json
vector_store/faiss_index/

# Noisy intermediate retrieval experiments - keep only FINAL_* + README
reports/retrieval_opt/retrieval_experiments_*

# Graphify runtime
graphify-out/

# Local browser captures
.playwright-cli/
docs/screenshots/*.png
frontend/screenshot_*.png

# OS specific
.DS_Store
Thumbs.db
*.lnk

# NOTE: deploy/k8s/base/secrets.yaml is intentionally TRACKED as a
# placeholder-only template (CHANGEME values). It is required by
# deploy/k8s/base/kustomization.yaml and CI kustomize build.
# Never put real credentials in it - use ExternalSecrets/KeyVault in prod.
# See SECURITY.md.
