  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Industrial Maintenance Copilot - System Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "HTTP Gateway Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(copilot_http_requests_total[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "HTTP Gateway Latency (p95 / p50)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(copilot_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(copilot_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Abstention Guardrail Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(copilot_abstention_events_total[5m])) by (reason)",
          "legendFormat": "Reason: {{reason}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Machine Telemetry & Alarms Ingestion",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "events/sec" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 6,
      "title": "Telemetry Ingestion Rate (REST vs MQTT)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(copilot_telemetry_events_total[1m])) by (transport, status)",
          "legendFormat": "{{transport}} - {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 7,
      "title": "Automated Alarms Generated by Fault Code",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum(copilot_alarms_generated_total) by (code, severity)",
          "legendFormat": "{{code}} ({{severity}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "title": "Multi-Agent & LLM Token Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 9,
      "title": "Specialist Agent Step Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(copilot_agent_step_duration_seconds_sum[5m]) / rate(copilot_agent_step_duration_seconds_count[5m])",
          "legendFormat": "Agent: {{agent}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "tokens/sec" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 10,
      "title": "LLM Token Throughput (Prompt / Completion)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(copilot_llm_tokens_total[5m])) by (provider, token_type)",
          "legendFormat": "{{provider}} - {{token_type}}"
        }
      ]
    }
  ],
  "refresh": "5s",
